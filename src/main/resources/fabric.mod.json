{
  "schemaVersion": 1,
  "id": "lowspec",
  "version": "${version}",
  "name": "LowSpec Client",
  "description": "Lightweight HUD and modules for low-end PCs, designed for weak hardware optimization.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.lowspec.client.LowSpecClient"]
  },
  "mixins": [
    { "config": "lowspec.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "sodium": "*",
    "lithium": "*",
    "ferritecore": "*",
    "entityculling": "*",
    "immediatelyfast": "*"
  }
}